{
  "info": {
    "name": "XFunding Hub — Loan Application API",
    "description": "Start the Laravel API with php artisan serve. baseUrl defaults to http://localhost:8000. Run folders in order, or run the full collection. Creation requests save their IDs to collection variables automatically. Each run creates new applications; no cleanup endpoint exists. No environment file or authentication is required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "applicationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "rejectedApplicationId",
      "value": "",
      "type": "string"
    },
    {
      "key": "validationApplicationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Approval and disbursement",
      "description": "Run in order. The first request creates and captures a fresh application ID.",
      "item": [
        {
          "name": "Create application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"applicationId\", pm.response.json().applicationId);",
                  "}",
                  "pm.test(\"Initial status is SUBMITTED\", function () { pm.expect(pm.response.json().status).to.eql(\"SUBMITTED\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"C1001\",\n  \"amount\": 5000,\n  \"currency\": \"GBP\",\n  \"termMonths\": 12\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/loan-applications"
          },
          "response": []
        },
        {
          "name": "Get submitted application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status is SUBMITTED\", function () { pm.expect(pm.response.json().status).to.eql(\"SUBMITTED\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/loan-applications/{{applicationId}}"
          },
          "response": []
        },
        {
          "name": "Start review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status is UNDER_REVIEW\", function () { pm.expect(pm.response.json().status).to.eql(\"UNDER_REVIEW\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"UNDER_REVIEW\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/loan-applications/{{applicationId}}/status"
          },
          "response": []
        },
        {
          "name": "Approve",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status is APPROVED\", function () { pm.expect(pm.response.json().status).to.eql(\"APPROVED\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/loan-applications/{{applicationId}}/status"
          },
          "response": []
        },
        {
          "name": "Disburse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status is DISBURSED\", function () { pm.expect(pm.response.json().status).to.eql(\"DISBURSED\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DISBURSED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/loan-applications/{{applicationId}}/status"
          },
          "response": []
        },
        {
          "name": "Get disbursed application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status is DISBURSED\", function () { pm.expect(pm.response.json().status).to.eql(\"DISBURSED\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/loan-applications/{{applicationId}}"
          },
          "response": []
        }
      ]
    },
